{
  "name": "victoria-bathhouse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint . --deny-warnings && eslint . --max-warnings=0",
    "lint:oxlint": "oxlint . --deny-warnings",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:fix": "oxlint . --fix --deny-warnings && eslint . --fix --max-warnings=0",
    "format": "prettier --write src tests *.json *.ts *.js .oxlintrc.json index.html README.md",
    "format:check": "prettier --check src tests *.json *.ts *.js .oxlintrc.json index.html README.md",
    "test": "node --test tests/*.test.ts tests/*.test.js",
    "check": "oxlint . --deny-warnings && eslint . --max-warnings=0 && node --test tests/*.test.ts tests/*.test.js && vue-tsc --noEmit && vite build"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "embla-carousel": "8.6.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "1.87.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "oxlint": "1.87.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
